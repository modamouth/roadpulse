# --- Supabase ---
# Project Settings → API in the Supabase dashboard.
# VITE_-prefixed vars are read by the frontend (Vite only exposes vars
# with that prefix to browser code) and go in frontend/.env. The anon
# key is safe to ship client-side — it's subject to the RLS policies in
# backend/src/db/schema.sql, which is the whole point.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-side only (repo-root .env — this file, not frontend/.env) —
# never ship this to the frontend. Project Settings → API → service_role
# key. Used by the pipeline ingestion route
# (backend/src/routes/pipeline.ts) if it calls Supabase via supabase-js
# instead of a direct Postgres connection.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database ---
# Supabase's *session pooler* connection string (dashboard → Connect →
# Direct → Method: "Session pooler", port 5432). Not the "Direct
# connection" — that host (db.<project-ref>.supabase.co) is IPv6-only
# unless you buy Supabase's IPv4 add-on, so it fails on IPv4-only
# networks. And not the "Transaction pooler" (port 6543) —
# migrate.ts/seed.ts run DDL and multi-statement SQL, which transaction
# mode doesn't support. Connects as the `postgres` role (shown as
# postgres.<project-ref>), which bypasses Row Level Security — required for
# migrations, seeding, and the pipeline's writes of
# historical_extracted/official incidents (see db/pool.ts). PostGIS is
# enabled by schema.sql (into the `extensions` schema), which Supabase
# allows without extra setup. Percent-encode special characters in the
# password. After a password reset the pooler can take a minute or two
# to accept the new one.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Backend (pipeline service only — see backend/src/server.ts) ---
PORT=4000
NODE_ENV=development

# --- Geocoding ---
# Nominatim (OpenStreetMap) — self-host or use a public instance for low volume.
# Respect usage policy: https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# --- n8n (automation / extraction pipeline) ---
# Only needed if the backend triggers or is triggered by n8n workflows directly.
N8N_WEBHOOK_URL=
N8N_API_KEY=

# --- Claude (news extraction pipeline) ---
# Used by pipelines/extraction — see pipelines/extraction/README.md
ANTHROPIC_API_KEY=
